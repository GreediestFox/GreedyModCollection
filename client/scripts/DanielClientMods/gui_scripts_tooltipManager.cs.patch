+//-----------------------------------------------------------------------------
+// FoodPerishability - Tooltip-Erweiterung
+//
+// Der Client hat keinen Datenbankzugriff, daher muss die Zuordnung
+// ObjectTypeID -> Verderbnisrate (Qualitaetspunkte pro Tag) hier als
+// statische Tabelle gefuehrt werden - inhaltlich identisch zu der Menge an
+// IDs, die serverseitig ueber f_foodPerishRate() (Server_mod/
+// FoodPerishability/sql.cs) anhand der ParentID-Kette ermittelt wird.
+// Wird dort spaeter eine neue ParentID/ein neues Item ergaenzt, muss diese
+// Tabelle von Hand nachgezogen werden.
+//
+// Honig (ObjectTypeID 376) ist bewusst NICHT gelistet (keine Verderbnis).
+//-----------------------------------------------------------------------------
+
+// WICHTIG: switch/case mit mehreren kommagetrennten Werten pro case-Label
+// (z.B. "case 1,2,3:") wird vom Torque3D-Scriptparser dieser Engine-Version
+// NICHT unterstuetzt - das fuehrte zuvor zu einem Parse-Error, der die
+// gesamte restliche Datei unkompiliert liess. Stattdessen: eine globale
+// Lookup-Tabelle ($FoodPerish::Rate[ObjectTypeID]), befuellt ueber
+// getWord()/getWordCount() aus einfachen leerzeichengetrennten ID-Listen -
+// beides seit langem im Spiel selbst genutzte, sicher unterstuetzte
+// TorqueScript-Funktionen (siehe z.B. heraldryDialog.cs / ferryMan.cs).
+function FoodPerish_registerRateList(%list, %rate)
+{
+	%count = getWordCount(%list);
+	for (%i = 0; %i < %count; %i++)
+	{
+		$FoodPerish::Rate[getWord(%list, %i)] = %rate;
+	}
+}
+
+// LiFx 2026-10-04: id lists regenerated from our objects_types (same rules as f_foodPerishRate in FoodSpoilagePack).
+function FoodPerish_initRateTable()
+{
+	// Rate 2 Q/d - ParentID 250 "Edible harvest" / 279 "Edible Parts"
+	FoodPerish_registerRateList("338 352 356 360 375 1027 2873 3175 3176 3177 3181 3805", 2);
+
+	// Rate 4 Q/d - ParentID 227-231 "Food and drink"
+	FoodPerish_registerRateList("316 951 952 953 954 955 956 957 958 959 960 963 964 965 966 967 968 969 970 971 972 973 974 975 976 977 978 979 980 981 982 983 984 985 986 987 988 989 990 991 992 993 994 995 996 997 998 999 1000 1001 1002 1003 1004 1005 1006 1007 1008 1009 1010 1011 1012 1013 1014 1015 1016 1017 1018 1019 1020 1021 1022 1023 1024 1025 1063 1064 3186 3187 3188 3189 3190 3191 3192 3193 3854 3855 3856 3857 3858 3859 3860 3861 3862 3863 3864 3865 3866 3867 3868 3869 3870 3871 3872 3873 3874 3875 3876 3877", 4);
+
+	// Rate 8 Q/d - ParentID 248 "Edible parts" (Meat 335 / Fish 340)
+	FoodPerish_registerRateList("335 336 340 383 384 385 386 390 391 392 393 394 3178 3179 3820 3821 3822", 8);
+}
+FoodPerish_initRateTable();
+
+function FoodPerish_getRate(%objectTypeID)
+{
+	if ($FoodPerish::Rate[%objectTypeID] $= "")
+	{
+		return 0;
+	}
+	return $FoodPerish::Rate[%objectTypeID];
+}
+
+// 30-Tage-Monate, wie von Daniel bestaetigt.
+$FoodPerish::DaysPerMonth = 30;
+// Unter dieser Restlaufzeit (in Tagen) wird die Zeitangabe rot eingefaerbt.
+$FoodPerish::WarningThresholdDays = 3;
+
+function FoodPerish_formatRemaining(%remainingDays)
+{
+	%months = mFloor(%remainingDays / $FoodPerish::DaysPerMonth);
+	%rest = %remainingDays - (%months * $FoodPerish::DaysPerMonth);
+	%weeks = mFloor(%rest / 7);
+	%days = mFloor(%rest - (%weeks * 7));
+
+	%txt = "";
+	if (%months > 0)
+	{
+		%txt = %txt @ %months @ GetMessageIDText(5196);
+	}
+	if (%weeks > 0)
+	{
+		if (%txt !$= "") { %txt = %txt @ " "; }
+		%txt = %txt @ %weeks @ GetMessageIDText(5197);
+	}
+	if (%days > 0 || %txt $= "")
+	{
+		if (%txt !$= "") { %txt = %txt @ " "; }
+		%txt = %txt @ %days @ GetMessageIDText(5198);
+	}
+	return %txt;
+}
+
+// Fuegt, falls das Item ueberhaupt verderblich ist, dem aktuell im Bau
+// befindlichen Tooltip (TooltipMainControl) eine Zeile mit der
+// hochgerechneten verbleibenden Haltbarkeit in Realzeit hinzu. Dies ist eine
+// reine Momentaufnahme-Hochrechnung auf Basis der aktuellen Quality und der
+// bekannten Verderbnisrate - kein live tickender Countdown.
+function FoodPerish_addShelfLifeRow(%informer)
+{
+	%typeID = %informer.getData("objects_types", "ID");
+	%rate = FoodPerish_getRate(%typeID);
+
+	if (%rate <= 0)
+	{
+		return;
+	}
+
+	%quality = %informer.getData("items", "Quality");
+	if (%quality $= "")
+	{
+		return;
+	}
+
+	%remainingDays = %quality / %rate;
+
+	%profile = "GuiLightTextTooltipProfile";
+	if (%remainingDays < $FoodPerish::WarningThresholdDays)
+	{
+		%profile = "GuiNegativeTextTooltipProfile";
+	}
+
+	// Icon + Text statt einer Textzeile mit Beschriftung, analog zur
+	// Darstellung der Effekt-/Wunden-Restdauer in createEffectTooltip()/
+	// createWoundTooltip() weiter oben in dieser Datei (dort ebenfalls
+	// TimeIcon ueber createIconPnl()).
+	%line = createHorizontalStackControl();
+	%line.padding = 16;
+	TooltipMainControl.add(%line);
+
+	%pnl = createIconPnl(%line, TimeIcon);
+	%textCtrl = createTextCtrl(%profile);
+	%textCtrl.setText(FoodPerish_formatRemaining(%remainingDays));
+	%pnl.add(%textCtrl);
+}
