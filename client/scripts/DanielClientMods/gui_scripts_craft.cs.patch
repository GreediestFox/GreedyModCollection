+// Neu: ermittelt und zeigt die vom aktuell gewaehlten Rezept geforderte
+// Mindestqualitaet fuer diese Zutat an.
+//
+// %itemTypeId == 0 bedeutet "Slot ist leer" (kein Zutat-Platz fuer dieses
+// Rezept vorgesehen bzw. clearInfo() wurde aufgerufen) -> "-", nicht gelb.
+// Sonst: 0 = keine Mindestqualitaet gefordert (Standardfarbe),
+//        > 0 = Mindestqualitaet gefordert (gelb hervorgehoben).
+function GuiCraftingComponentSlot::updateQualityRequirement(%this, %itemTypeId)
+{
+	CraftReq_EnsureLoaded();
+
+	if (%itemTypeId == 0)
+	{
+		%this-->qualityReq.setText("-");
+		%this-->qualityReq.setProfile(GuiCraftRecipeComponentQualityProfile);
+		return;
+	}
+
+	%reqQuality = 0;
+	%recipeId = GuiCraftWindows.selectedRecipeId;
+	if (%recipeId !$= "")
+	{
+		%lookup = $CraftReq::Quality[%recipeId, %itemTypeId];
+		if (%lookup !$= "")
+			%reqQuality = %lookup;
+	}
+
+	if (%reqQuality == 0)
+	{
+		%this-->qualityReq.setText("0");
+		%this-->qualityReq.setProfile(GuiCraftRecipeComponentQualityProfile);
+	}
+	else
+	{
+		%this-->qualityReq.setText(%reqQuality);
+		%this-->qualityReq.setProfile(GuiCraftRecipeComponentQualityReqProfile);
+	}
+}
