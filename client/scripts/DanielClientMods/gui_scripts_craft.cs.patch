+//-----------------------------------------------------------------------------
+// Mindestqualitaet je Rezept-Zutat (aus recipe_requirement.xml)
+//
+// Die Engine uebergibt GuiCraftingComponentSlot::setInfo() nur itemTypeId,
+// itemName, optionallyRegional und regionName - keine Qualitaetsangabe.
+// recipe_requirement.xml liegt aber als normale Datendatei vor und wird
+// hier einmalig selbst eingelesen (SimXMLDocument), um pro
+// (RecipeID, MaterialObjectTypeID) die geforderte Mindestqualitaet
+// nachschlagen zu koennen.
+//-----------------------------------------------------------------------------
+
+$CraftReq::Loaded = false;
+
+// Liest den Text eines Kindelements (%childName) des aktuellen <row>-Elements.
+//
+// Testergebnis vom 2026-07-07: elementValue() liefert in dieser Engine
+// (fälschlich) den Namen des Elements selbst zurück (z.B. "Quality" statt
+// "60"), waehrend getText() korrekt den eigentlichen Textinhalt liefert
+// (bestaetigt per Debug-Log: elementValue=[Quality] getText=[0]).
+// Deshalb wird ausschliesslich getText() verwendet.
+function CraftReq_ReadElementText(%xml, %childName, %debugLog)
+{
+	%value = "";
+
+	if (%xml.pushFirstChildElement(%childName))
+	{
+		%value = %xml.getText();
+
+		if (%debugLog)
+		{
+			echo("CraftReq_EnsureLoaded DEBUG <" @ %childName @ ">: getText=[" @ %value @ "]");
+		}
+
+		%xml.popElement();
+	}
+	else if (%debugLog)
+	{
+		echo("CraftReq_EnsureLoaded DEBUG <" @ %childName @ ">: Kindelement nicht gefunden");
+	}
+
+	return %value;
+}
+
+function CraftReq_EnsureLoaded()
+{
+	if ($CraftReq::Loaded)
+		return;
+
+	// Nur einmal versuchen - auch wenn das Laden fehlschlaegt, nicht bei
+	// jedem Oeffnen des Craftingfensters erneut probieren.
+	$CraftReq::Loaded = true;
+
+	%path = "data/recipe_requirement.xml";
+	if (!isFile(%path))
+	{
+		warn("CraftReq_EnsureLoaded: Datei nicht gefunden: " @ %path);
+		return;
+	}
+
+	%xml = new SimXMLDocument();
+	if (!%xml.loadFile(%path))
+	{
+		warn("CraftReq_EnsureLoaded: konnte " @ %path @ " nicht laden");
+		%xml.delete();
+		return;
+	}
+
+	%rowCount = 0;
+	%withQuality = 0;
+
+	// Wichtig: pushFirstChildElement("table") statt pushChildElement(0) -
+	// entspricht dem offiziellen SimXMLDocument-Beispiel (Wurzelelement wird
+	// direkt ueber seinen Namen angesprochen). Die urspruengliche Variante
+	// mit pushChildElement(0) hat beim Test keine einzige Zeile gefunden
+	// (0 Eintraege geladen, obwohl die Testdatei einen Wert > 0 enthielt).
+	if (%xml.pushFirstChildElement("table"))
+	{
+		%hasRow = %xml.pushFirstChildElement("row");
+		while (%hasRow)
+		{
+			%rowCount++;
+			%debugThisRow = (%rowCount == 1);
+
+			%recipeId = CraftReq_ReadElementText(%xml, "RecipeID", %debugThisRow);
+			%materialId = CraftReq_ReadElementText(%xml, "MaterialObjectTypeID", %debugThisRow);
+			%quality = CraftReq_ReadElementText(%xml, "Quality", %debugThisRow);
+			if (%quality $= "")
+				%quality = 0;
+
+			if (%recipeId !$= "" && %materialId !$= "" && %quality > 0)
+			{
+				$CraftReq::Quality[%recipeId, %materialId] = %quality;
+				%withQuality++;
+			}
+
+			%hasRow = %xml.nextSiblingElement("row");
+		}
+
+		%xml.popElement(); // zurueck auf <table>
+	}
+	else
+	{
+		warn("CraftReq_EnsureLoaded: <table>-Wurzelelement nicht gefunden in " @ %path);
+	}
+
+	%xml.delete();
+
+	echo("CraftReq_EnsureLoaded: " @ %rowCount @ " <row>-Eintraege gelesen, davon " @ %withQuality @ " mit Mindestqualitaet > 0 (" @ %path @ ")");
+}
